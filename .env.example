# MeteoRight configuration — copy to `.env` and edit, or export these directly.
#
# All settings have working defaults: with nothing set, MeteoRight uses the
# public Open-Meteo API (rate-limited, fine for small experiments and the
# bundled demo). Set a base URL to route everything at a self-hosted backend.

# ---------------------------------------------------------------------------
# Open-Meteo data backend
# ---------------------------------------------------------------------------

# Point all requests at a self-hosted Open-Meteo instance. Use 127.0.0.1 (not
# "localhost") if the backend binds IPv4-only. Leave unset to use the public API.
# METEORIGHT_OPEN_METEO_BASE_URL=http://127.0.0.1:8080

# Commercial Open-Meteo API key, sent as the `apikey` query parameter.
# METEORIGHT_OPEN_METEO_API_KEY=your-key

# Per-endpoint overrides (take precedence over METEORIGHT_OPEN_METEO_BASE_URL).
# Only needed when a deployment splits endpoints across separate domains.
# METEORIGHT_OPEN_METEO_ARCHIVE_API=https://archive-api.open-meteo.com/v1/archive
# METEORIGHT_OPEN_METEO_SINGLE_RUNS_API=https://single-runs-api.open-meteo.com/v1/forecast
# METEORIGHT_OPEN_METEO_PREVIOUS_RUNS_API=https://previous-runs-api.open-meteo.com/v1/forecast
# METEORIGHT_OPEN_METEO_HISTORICAL_FORECAST_API=https://historical-forecast-api.open-meteo.com/v1/forecast

# Note: the LangGraph agent (LLM endpoint config, METEORIGHT_LLM_*) lives in the
# separate `meteoright-agent` companion project, not here.
